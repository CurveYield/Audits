    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@openzeppelin/contracts": "5.4.0",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.0",
    "mocha": "11.7.6",
    "solc": "0.8.28"
  },
  "private": true
